// gzsys-xujm: SGE smp / all.q. Paths must be shared at the same name on all nodes.
params {
    gzsys_queue = 'all.q'
    gzsys_penv = 'smp'
    gzsys_queue_size = 3
    gzsys_root = '/share/data7/Project/xujm/MIDASv3'
    download_databases = false
    gzsys_min_free_gb = 100
}

workDir = "${params.gzsys_root}/work"
conda.cacheDir = "${params.gzsys_root}/conda"
conda.createTimeout = '2 h'

process {
    executor = 'sge'
    queue = params.gzsys_queue
    penv = params.gzsys_penv
    cpus = 1
    memory = 4.GB
    time = 4.h
    shell = ['/bin/bash', '-euo', 'pipefail']
    cache = true
    maxRetries = 2
    errorStrategy = { task.exitStatus in [137, 140, 143] && task.attempt <= 2 ? 'retry' : 'terminate' }
    // Nextflow's SGE executor emits h_rss/mem_free from task.memory natively.
    // mem_free is non-consumable here; default to 3 jobs, each capped at 32 GB.
    clusterOptions = '-S /bin/bash -R y'

    withLabel: single_cpu {
        cpus = 1
        memory = { [4.GB * task.attempt, 32.GB].min() }
        time = { 4.h * task.attempt }
    }
    withLabel: mem_medium {
        cpus = 4
        memory = { [8.GB * task.attempt, 32.GB].min() }
        time = { 8.h * task.attempt }
    }
    withLabel: mem_high {
        cpus = 8
        memory = { [16.GB * task.attempt, 32.GB].min() }
        time = { 12.h * task.attempt }
    }
    withLabel: mem_very_high {
        cpus = 16
        memory = { 32.GB }
        time = { 24.h * task.attempt }
    }
}

executor {
    queueSize = params.gzsys_queue_size
    submitRateLimit = '1/5sec'
}

def reportStamp = new Date().format("yyyyMMdd-HHmmss-SSS")

trace {
    enabled = true
    file = "${launchDir}/trace-${reportStamp}.tsv"
}
report {
    enabled = true
    file = "${launchDir}/report-${reportStamp}.html"
}
timeline {
    enabled = true
    file = "${launchDir}/timeline-${reportStamp}.html"
}
