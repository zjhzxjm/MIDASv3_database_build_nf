// Defaults can be overridden with -params-file or command-line parameters.
params {
    genomes_tsv_path = null
    centroid_cluster_percents = [99, 95, 90, 85, 80, 75]
    run_chunk_size = 1000000
    merge_chunk_size = 500000
    resfinder_min_cov = 0.6
    resfinder_identity_threshold = 0.8
    hmmsearch_min_cov = 0.0
    hmmsearch_max_evalue = 1e-5
    marker_set = 'phyeco'
    db_name = 'nextflow_db'
    db_output_dir = '.'
    eggnog_db_dir = 'databases/eggnog'
    genomad_db_dir = 'databases/genomad'
    genomad_db_url = 'https://zenodo.org/records/8339387/files/genomad_db_v1.5.tar.gz?download=1'
    resfinder_db_dir = 'databases/resfinder'
    eggnog_dmnd_db_name = 'eggnog_proteins.dmnd'
    download_databases = true
}

process {
    maxRetries = 3
    cache = 'lenient'
    // conda = "${projectDir}/env/MIDASv3.yml"
    errorStrategy = { task.attempt < 5 ? 'retry' : 'ignore' }

    beforeScript = 'export CRYPTOGRAPHY_OPENSSL_NO_LEGACY=1'
}

conda { 
    enabled = true 
    cacheDir = ".env"  
} 

includeConfig 'conf/conda_envs.config'


// apptainer {
//     enabled = true
//     cacheDir = '/wynton/home/sirota/clairedubin/singularity_image/'
//     autoMounts = true
// }

env {
    PYTHONPATH = "${baseDir}/bin"
}

profiles {
  gzsys {
    includeConfig 'conf/gzsys.config'
  }

  
  standard {
    executor {
        queueSize = 1000 
        submitRateLimit = '1/5sec'
    }

    process {

        executor = 'sge'
        penv = 'smp'
        
        withLabel: 'mem_very_high' {
          cpus = 16
          memory = { 4.GB * task.attempt }
          time = { 8.hour * task.attempt }
          clusterOptions = { " -S /bin/bash -R y -l h_vmem=${task.memory.toString().replaceAll(/[\sB]/,'')}" }
        }

        withLabel: 'mem_high' {
          cpus = 6
          memory = { 4.GB * task.attempt }
          time = { 6.hour * task.attempt }     
          clusterOptions = { " -S /bin/bash -R y -l h_vmem=${task.memory.toString().replaceAll(/[\sB]/,'')}" }
        }

        withLabel: 'mem_medium' {
          cpus = 2
          memory = { 8.GB * task.attempt }
          time = { 4.hour * task.attempt }  
          clusterOptions = { " -S /bin/bash -R y -l h_vmem=${task.memory.toString().replaceAll(/[\sB]/,'')}" }
        }

        withLabel: 'single_cpu' {
          cpus = 1
          memory = { 4.GB * task.attempt }
          time = { 4.hour * task.attempt }
          clusterOptions = { " -S /bin/bash -R y -l h_vmem=${task.memory.toString().replaceAll(/[\sB]/,'')}" }
        }
    }
  } 
}
